    "id": "spring_damping",
    "prerequisites": ["targeted_force"],
    "suggested_order": 160,
    "summary": "Two equal masses start on stretched springs. The upper spring conserves energy; the lower damper gradually slows the motion. On the right, a torsional spring turns a bar back towards its rest angle.",
    "title": "Springs and dampers"
  },
  "version": {
    "major": 1,
    "minor": 1
  },
  "guide": {"focus":"Watch energy move between kinetic and stored spring energy. Compare this with the lower oscillator, where damping removes energy.","predict":{"prompt":"After increasing the elastic mass, what happens to its oscillation period?","options":["It becomes longer","It becomes shorter","It is unchanged"]},"variables":[{"control":"object.properties.mass","label":"Elastic mass","body":"body-1-2"},{"control":"spring.linear.damping","label":"Damped spring damping","instance":"damped"}],"steps":[{"text":"Run and compare the elastic and damped amplitudes."},{"text":"Open the damped spring card and change its damping.","control":"spring.linear.damping","instance":"damped"},{"text":"Increase the elastic mass, press R, and compare periods.","control":"object.properties.mass","body":"body-1-2"}],"expect":"Damping removes mechanical energy, so each swing becomes smaller. With the same stiffness, a heavier mass takes longer to complete a cycle.","limits":"The springs follow ideal linear laws, damping is viscous, and the anchors stay fixed."},
