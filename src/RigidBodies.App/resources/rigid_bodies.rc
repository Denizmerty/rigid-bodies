#include <windows.h>
#pragma code_page(65001)
#include <rigidbodies/project_identity.hpp>

IDI_RIGIDBODIES ICON "../../../assets/branding/rigid-bodies.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION RIGIDBODIES_VERSION_MAJOR,RIGIDBODIES_VERSION_MINOR,RIGIDBODIES_VERSION_PATCH,0
 PRODUCTVERSION RIGIDBODIES_VERSION_MAJOR,RIGIDBODIES_VERSION_MINOR,RIGIDBODIES_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", RIGIDBODIES_AUTHOR
            VALUE "Comments", RIGIDBODIES_CONTACT
            VALUE "FileDescription", "Rigid Bodies"
            VALUE "FileVersion", RIGIDBODIES_VERSION_STRING
            VALUE "InternalName", "rigid_bodies"
            VALUE "OriginalFilename", "rigid_bodies.exe"
            VALUE "LegalCopyright", RIGIDBODIES_COPYRIGHT
            VALUE "License", RIGIDBODIES_LICENSE
            VALUE "ProductName", "Rigid Bodies"
            VALUE "ProductVersion", RIGIDBODIES_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
